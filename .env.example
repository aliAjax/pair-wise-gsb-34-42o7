# 复制为 .env 后由 docker compose 自动加载：cp .env.example .env && docker compose up -d
COMPOSE_PROJECT_NAME=fire-inspect

# 宿主机映射端口
FRONTEND_PORT=20103
BACKEND_PORT=21103
DB_PORT=54320

# PostgreSQL 凭据（容器内库名/账号）
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# 后端配置
JWT_SECRET=local-dev-secret
JWT_EXPIRE_MINUTES=480
RATE_LIMIT_PER_MINUTE=120
# 启动时自动建表并写入种子账号与示范任务
SEED_ON_START=true
